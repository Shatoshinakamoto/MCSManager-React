# MCSManager panel (web), run as the unprivileged "mcsm" account.
# The panel never needs root. Install guide: docs/install-guide.md
#   sudo cp mcsm-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mcsm-web
[Unit]
Description=MCSManager Panel (web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcsm
Group=mcsm
WorkingDirectory=/opt/mcsmanager/web
ExecStart=/usr/bin/env node --max-old-space-size=8192 --enable-source-maps app.js
Restart=on-failure
RestartSec=5
UMask=0077
# Hardening (systemd.exec(5)). The panel only writes inside its own folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/mcsmanager/web
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
