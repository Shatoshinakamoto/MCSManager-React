# MCSManager daemon for one ordinary account, with no admin rights at run time
# (systemd user service). Install guide: docs/install-guide.md (method C).
#   mkdir -p ~/.config/systemd/user && cp mcsm-user-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now mcsm-user-daemon
# To keep it running after you log out, an administrator runs once:
#   sudo loginctl enable-linger <your-account>
[Unit]
Description=MCSManager daemon (user service)

[Service]
Type=simple
WorkingDirectory=%h/mcsmanager/daemon
ExecStart=/usr/bin/env node --max-old-space-size=4096 app.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
KillMode=mixed

[Install]
WantedBy=default.target
