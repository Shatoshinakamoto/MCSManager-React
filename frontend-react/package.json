{
  "name": "mcsmanager-ui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React port of the MCSManager web UI. Talks to the unchanged MCSManager panel API and reuses its layout schema and language files.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fvilers/disable-react-devtools": "1.3.0",
    "@uiw/codemirror-theme-tokyo-night": "4.25.12",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "antd": "6.6.7",
    "axios": "1.20.0",
    "codemirror": "6.0.2",
    "dayjs": "1.11.23",
    "disable-devtool": "0.3.9",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "eventemitter3": "5.0.4",
    "fflate": "0.8.3",
    "i18next": "26.5.10",
    "marked": "18.1.1",
    "pretty-bytes": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "react-router": "7.18.4",
    "socket.io-client": "4.8.4",
    "wavesurfer.js": "7.12.12",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "sass": "1.106.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
