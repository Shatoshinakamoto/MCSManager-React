{
  "name": "mcsmanager-ui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React port of the MCSManager web UI. Talks to the unchanged MCSManager panel API and reuses its layout schema and language files.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.7",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "eventemitter3": "5.0.4",
    "i18next": "26.5.10",
    "marked": "18.1.1",
    "pretty-bytes": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "react-router": "7.18.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "sass": "1.106.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
